DATABASE_URL="postgresql://umkm:umkm_secret@localhost:5432/umkm_hub?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-umkm-hub-dev"
JWT_REFRESH_SECRET="change-me-refresh-secret-umkm-hub-dev"
# Optional: dedicated key for profile location/IP HMAC digests (falls back to JWT_ACCESS_SECRET)
# PROFILE_LOCATION_SECRET="change-me-profile-location-hmac-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
# Public web origin used in email verification links
APP_PUBLIC_URL="http://localhost:3000"

# --- Production (Vercel + Firebase umkm-hub-2b955 + Redis) ---
# Firebase Admin SDK — verify ID tokens from the web/mobile Firebase clients.
# Console: https://console.firebase.google.com/project/umkm-hub-2b955/settings/serviceaccounts/adminsdk
FIREBASE_PROJECT_ID="umkm-hub-2b955"
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
# Option B: full service account JSON (single line)
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Upstash Redis (free tier) — shared rate limits + analytics cache across API instances.
# Create a database at https://upstash.com and copy REST credentials.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Legacy aliases (also supported):
# REDIS_URL=""
# REDIS_TOKEN=""

# Optional: Resend for outbound mail (without it, verify URLs are logged in API)
# RESEND_API_KEY=""
# EMAIL_FROM="UMKM Hub <noreply@yourdomain.com>"
# Optional: dedicated HMAC secret for email verify tokens (falls back to JWT_ACCESS_SECRET)
# EMAIL_VERIFY_SECRET="change-me-email-verify-secret"
# Optional: dedicated HMAC secret for password reset tokens (falls back to JWT_ACCESS_SECRET)
# PASSWORD_RESET_SECRET="change-me-password-reset-secret"
# Optional overrides for prisma seed (defaults: rifqi_tjahyono / 12041994)
# SEED_PROFILE_NAME="rifqi_tjahyono"
# SEED_PROFILE_PASSWORD="12041994"
# Set to true only when you intentionally want to reset the sandbox password
# SEED_RESET_PASSWORD="false"
# Privileged cross-tenant data export allowlist (comma-separated profile names).
# Those users export ALL profiles; everyone else exports only their own profile.
# DATA_EXPORT_PROFILE_NAMES="rifqi_tjahyono"
# Bootstrap password for brand-new profiles created during cross-tenant import only.
# IMPORT_BOOTSTRAP_PASSWORD="umkm-import-change-me"
# Optional sandbox plaintext passwords for privileged exports (profileName:password pairs).
# Included in export only when the stored bcrypt hash still matches.
# SANDBOX_EXPORT_PASSWORDS="rifqi_tjahyono:12041994,demo:demopass1"
