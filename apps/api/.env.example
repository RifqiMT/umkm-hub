# =============================================================================
# UMKM Hub API — LOCAL development (copy to .env)
# =============================================================================
# Used by: npm run setup / npm run api:dev
# Database: Docker Postgres from docker-compose.yml (npm run db:up)
# Auth: JWT + bcrypt (leave Firebase Admin vars unset)
# Redis: optional — omit for in-process throttling/cache fallback
# Production values: docs/ENV-UMKM-HUB-PRODUCTION.md (Render dashboard only)
# =============================================================================

NODE_ENV=development
APP_ENV=local

DATABASE_URL="postgresql://umkm:umkm_secret@localhost:5432/umkm_hub?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-umkm-hub-dev"
JWT_REFRESH_SECRET="change-me-refresh-secret-umkm-hub-dev"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
APP_PUBLIC_URL="http://localhost:3000"

# Optional: dedicated key for profile location/IP HMAC digests (falls back to JWT_ACCESS_SECRET)
# PROFILE_LOCATION_SECRET="change-me-profile-location-hmac-secret"

# Optional: Resend for outbound mail (without it, verify/reset URLs are logged in the API console)
# RESEND_API_KEY=""
# EMAIL_FROM="UMKM Hub <noreply@localhost>"
# EMAIL_VERIFY_SECRET="change-me-email-verify-secret"
# PASSWORD_RESET_SECRET="change-me-password-reset-secret"

# Optional sandbox seed overrides (defaults: rifqi_tjahyono / 12041994)
# SEED_PROFILE_NAME="rifqi_tjahyono"
# SEED_PROFILE_PASSWORD="12041994"
# SEED_RESET_PASSWORD="false"

# Optional export/import sandbox keys (local dev only — never use in production)
# DATA_EXPORT_PROFILE_NAMES="rifqi_tjahyono"
# IMPORT_BOOTSTRAP_PASSWORD="umkm-import-change-me"
# SANDBOX_EXPORT_PASSWORDS="rifqi_tjahyono:12041994,demo:demopass1"

# =============================================================================
# OPTIONAL — test Firebase locally (same project as prod is NOT recommended)
# =============================================================================
# Leave all Firebase vars commented for JWT-only local auth (recommended).
# FIREBASE_PROJECT_ID="umkm-hub-2b955"
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# =============================================================================
# OPTIONAL — local Redis (omit for in-process fallback)
# =============================================================================
# REDIS_URL="redis://localhost:6379"
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
