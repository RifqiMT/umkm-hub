{
  "name": "umkm-hub",
  "private": true,
  "version": "1.0.0",
  "description": "UMKM Hub monorepo",
  "scripts": {
    "setup": "bash scripts/sync-env.sh setup",
    "sync": "bash scripts/sync-env.sh sync",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix apps/api run prisma:deploy",
    "db:generate": "npm --prefix apps/api run prisma:generate",
    "db:seed": "npm --prefix apps/api run prisma:seed",
    "db:repair": "bash scripts/repair-local-migrations.sh",
    "db:reset": "bash scripts/db-reset-local.sh",
    "api:dev": "npm --prefix apps/api run start:dev",
    "api:test": "npm --prefix apps/api test",
    "web:dev": "npm --prefix apps/web run dev",
    "web:dev:clean": "rm -rf apps/web/.next && npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "build": "npm --prefix apps/web run build",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "deploy:env": "bash scripts/print-production-env.sh",
    "dev:check": "bash scripts/dev-check.sh",
    "setup:check": "bash scripts/setup-check.sh",
    "setup:prod:check": "bash scripts/setup-check.sh",
    "setup:open": "bash scripts/open-setup-links.sh",
    "setup:firebase-vercel": "bash scripts/add-firebase-to-vercel.sh",
    "glossary:sync": "npx tsx scripts/sync-glossary-mobile.ts"
  }
}
